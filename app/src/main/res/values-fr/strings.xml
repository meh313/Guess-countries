<?xml version="1.0" encoding="utf-8"?>
<!--
  Mots partagés par plusieurs écrans, et les libellés des enums (modes de quiz, portées, ordres de tri, états…),
  vers lesquels `ui/Labels.kt` pointe. Chaque écran garde ses propres mots dans `strings_<écran>.xml`. Les valeurs
  stockées (noms de modes, clés de portée, noms de continents, sources d’étude) ne sont jamais ces chaînes : elles
  restent les clés anglaises et ne sont traduites qu’à l’affichage.
-->
