<?xml version="1.0" encoding="utf-8"?>
<!--
  Le mode Apprendre (« Apprendre 5 nouveaux ») : cinq drapeaux jamais vus, une carte à la fois, puis un petit quiz
  dessus. Le quiz lui-même utilise les chaînes de quiz ; son libellé de portée est ici.
-->
<!-- « Carte 1 sur 5 » ne change pas de formulation avec le nombre : une chaîne simple, comme celle des cartes mémoire. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PluralsCandidate">
    <!-- L'entrée du sélecteur d'étude des cartes mémoire (le titre de l'écran la partage) -->
    <string name="learn_title">Apprendre %1$d nouveaux</string>
    <plurals name="learn_option_detail">
        <item quantity="one">%1$d drapeau pas encore vu</item>
        <item quantity="other">%1$d drapeaux pas encore vus</item>
        <item quantity="many">%1$d drapeaux pas encore vus</item>
    </plurals>

    <!-- Les cartes -->
    <string name="learn_intro">Cinq drapeaux jamais vus, puis un petit quiz.</string>
    <string name="learn_card_position">Carte %1$d sur %2$d</string>
    <string name="learn_not_to_confuse">À ne pas confondre avec</string>
    <string name="learn_previous">Précédente</string>
    <string name="learn_next">Suivante</string>
    <string name="learn_quiz_me">Passer au quiz</string>

    <!-- Plus rien à présenter -->
    <string name="learn_nothing_new">Vous avez vu tous les drapeaux. Les quiz continuent de les réviser.</string>

    <!-- La portée du quiz après les cartes, dans le journal des quiz -->
    <string name="scope_learn">Apprentissage</string>
    <string name="learn_borders">Frontières : %1$s</string>
    <string name="learn_no_borders">Pas de frontière terrestre</string>
</resources>
