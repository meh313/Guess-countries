<?xml version="1.0" encoding="utf-8"?>
<!--
  The quiz tab: the setup screen (`quiz_`), the question screen (`quiz_`) and the score screen (`result_`). The mode,
  difficulty, scope and skill labels are shared and live in strings.xml.
-->
<!--
  A count is a plurals wherever a word next to it changes with the number in one of the five languages. The plain
  strings hold a fixed number (QuizEngine.MIN_POOL, the length of the blitz), a count one form covers in every
  language (the 4 to 10 weak spots) or a count no word agrees with ("Question 3 of 10", "Score: 40").
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PluralsCandidate">
    <!-- Setup: header -->
    <string name="quiz_title">Quiz de geografía y banderas</string>
    <string name="quiz_subtitle">Pon a prueba lo que sabes y mantén tu racha</string>

    <!-- Setup: mode -->
    <string name="quiz_select_mode">Elige el modo</string>
    <plurals name="quiz_seconds_per_question">
        <item quantity="one">%d segundo por pregunta</item>
        <item quantity="other">%d segundos por pregunta</item>
        <item quantity="many">%d segundos por pregunta</item>
    </plurals>
    <string name="quiz_no_time_limit">Sin límite de tiempo (ver Ajustes)</string>

    <!-- Setup: scope -->
    <string name="quiz_select_scope">Elige el alcance</string>
    <string name="quiz_scope_whole_world">El quiz de continentes siempre abarca todo el mundo</string>
    <string name="quiz_scope_due_count">%1$s · %2$d</string>
    <string name="quiz_due_nothing">No hay nada pendiente de repaso hoy</string>
    <plurals name="quiz_due_note_countries">
        <item quantity="one">El %1$d país pendiente de repaso, con respuestas de todo el mundo</item>
        <item quantity="other">Los %1$d países pendientes de repaso, con respuestas de todo el mundo</item>
        <item quantity="many">Los %1$d países pendientes de repaso, con respuestas de todo el mundo</item>
    </plurals>
    <plurals name="quiz_due_note_capitals">
        <item quantity="one">La %1$d capital pendiente de repaso, con respuestas de todo el mundo</item>
        <item quantity="other">Las %1$d capitales pendientes de repaso, con respuestas de todo el mundo</item>
        <item quantity="many">Las %1$d capitales pendientes de repaso, con respuestas de todo el mundo</item>
    </plurals>
    <string name="quiz_weak_spots_locked_countries">Puntos débiles se desbloquea cuando %1$d países repasados estén por debajo del dominio (tienes %2$d)</string>
    <string name="quiz_weak_spots_locked_capitals">Puntos débiles se desbloquea cuando %1$d capitales repasadas estén por debajo del dominio (tienes %2$d)</string>
    <string name="quiz_weak_spots_note_countries">Tus %1$d países más flojos, con respuestas de todo el mundo</string>
    <string name="quiz_weak_spots_note_capitals">Tus %1$d capitales más flojas, con respuestas de todo el mundo</string>

    <!-- Setup: answers difficulty -->
    <string name="quiz_answers">Respuestas</string>
    <string name="quiz_look_alikes_flags_only">Las respuestas parecidas se aplican a las preguntas de banderas</string>

    <!-- Setup: start button -->
    <string name="quiz_start_blitz">Iniciar blitz de %1$d segundos</string>
    <plurals name="quiz_start_quiz">
        <item quantity="one">Iniciar quiz de %d pregunta</item>
        <item quantity="other">Iniciar quiz de %d preguntas</item>
        <item quantity="many">Iniciar quiz de %d preguntas</item>
    </plurals>
    <string name="quiz_needs_countries">Requiere al menos %1$d países</string>

    <!-- Play: status bar -->
    <string name="quiz_progress_blitz">Pregunta %1$d · Correctas %2$d</string>
    <string name="quiz_progress">Pregunta %1$d de %2$d</string>
    <string name="quiz_score">Puntos: %1$d</string>
    <string name="quiz_streak">Seguidas %1$d</string>
    <string name="quiz_quit">Salir del quiz</string>

    <!-- Play: timers -->
    <plurals name="quiz_seconds_in_total">
        <item quantity="one">%d segundo en total</item>
        <item quantity="other">%d segundos en total</item>
        <item quantity="many">%d segundos en total</item>
    </plurals>
    <plurals name="quiz_seconds_left">
        <item quantity="one">Queda %d segundo</item>
        <item quantity="other">Quedan %d segundos</item>
        <item quantity="many">Quedan %d segundos</item>
    </plurals>
    <string name="quiz_seconds_left_short">%1$d s</string>

    <!-- Play: options -->
    <string name="quiz_option_correct">Respuesta correcta</string>
    <string name="quiz_option_incorrect">Tu respuesta, incorrecta</string>

    <!-- Play: after the answer -->
    <string name="quiz_result_timeout">¡Se acabó el tiempo! La respuesta es %1$s</string>
    <plurals name="quiz_result_correct">
        <item quantity="one">¡Correcto! +%d punto</item>
        <item quantity="other">¡Correcto! +%d puntos</item>
        <item quantity="many">¡Correcto! +%d puntos</item>
    </plurals>
    <string name="quiz_result_wrong">Casi. La respuesta es %1$s</string>
    <string name="quiz_result_also_counted">Correcto: %1$s también vale, aunque el catálogo lo lista como %2$s</string>
    <string name="quiz_capital_and_country">%1$s, %2$s</string>
    <string name="quiz_typed_label">Nombre del país</string>
    <string name="quiz_typed_submit">Comprobar</string>
    <string name="quiz_typed_hint">Valen las formas cortas: UK, USA, DRC. Se perdona una errata.</string>
    <string name="quiz_fact_capital">Su capital: %1$s</string>
    <string name="quiz_finish">Terminar y ver puntuación</string>
    <string name="quiz_next_question">Siguiente pregunta</string>

    <!-- Play: quit dialog -->
    <string name="quiz_quit_title">¿Salir de este quiz?</string>
    <!-- Every answer given so far was recorded as it was given; only the unfinished quiz's points, its log entry and its streak credit go. -->
    <string name="quiz_quit_text">Se perderán los puntos de este quiz y no contará para tu racha. Las respuestas que ya has dado se conservan en tu progreso.</string>
    <string name="quiz_quit_confirm">Salir</string>
    <string name="quiz_quit_cancel">Seguir jugando</string>

    <!-- Score screen: header and numbers -->
    <string name="result_times_up">¡Se acabó el tiempo!</string>
    <string name="result_complete">¡Quiz completado!</string>
    <string name="result_blitz_score">%1$s · %2$s</string>
    <plurals name="result_correct_count">
        <item quantity="one">%d correcta</item>
        <item quantity="other">%d correctas</item>
        <item quantity="many">%d correctas</item>
    </plurals>
    <plurals name="result_blitz_flags">
        <item quantity="one">%1$d bandera en %2$d segundos</item>
        <item quantity="other">%1$d banderas en %2$d segundos</item>
        <item quantity="many">%1$d banderas en %2$d segundos</item>
    </plurals>
    <string name="result_correct_ratio">Respuestas correctas: %1$d / %2$d</string>
    <plurals name="result_points">
        <item quantity="one">%d punto</item>
        <item quantity="other">%d puntos</item>
        <item quantity="many">%d puntos</item>
    </plurals>
    <string name="result_answers">Respuestas: %1$s</string>
    <plurals name="result_streak_already_counted">
        <item quantity="one">Racha de %d día, ya contada hoy</item>
        <item quantity="other">Racha de %d días, ya contada hoy</item>
        <item quantity="many">Racha de %d días, ya contada hoy</item>
    </plurals>

    <!-- Score screen: the misses -->
    <string name="result_perfect">¡Todas las respuestas correctas!</string>
    <string name="result_mistakes">Errores (%1$d)</string>
    <string name="result_no_answer">Sin respuesta a tiempo</string>
    <string name="result_picked_capital">Elegiste %1$s, %2$s</string>
    <string name="result_picked">Elegiste %1$s</string>
    <string name="result_picked_text">Elegiste: %1$s</string>
    <string name="result_miss_description">%1$s. %2$s</string>

    <!-- Score screen: the ways on -->
    <string name="result_practise_mistakes">Practicar errores</string>
    <string name="result_retry">Repetir</string>

    <!-- Score screen of a logged quiz, opened from the Progress log: "Quiz from 12 Oct" -->
    <string name="review_title">Quiz del %1$s</string>
</resources>
