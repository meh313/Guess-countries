<?xml version="1.0" encoding="utf-8"?>
<!--
  The quiz tab: the setup screen (`quiz_`), the question screen (`quiz_`) and the score screen (`result_`). The mode,
  difficulty, scope and skill labels are shared and live in strings.xml.
-->
<!--
  A count is a plurals wherever a word next to it changes with the number in one of the five languages. The plain
  strings hold a fixed number (QuizEngine.MIN_POOL, the length of the blitz), a count one form covers in every
  language (the 4 to 10 weak spots) or a count no word agrees with ("Question 3 of 10", "Score: 40").
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PluralsCandidate">
    <!-- Setup: header -->
    <string name="quiz_title">اختبار الجغرافيا والأعلام</string>
