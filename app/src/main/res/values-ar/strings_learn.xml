<?xml version="1.0" encoding="utf-8"?>
<!--
  Learn mode ("Learn 5 new"): five flags never seen before, one card at a time, then a short quiz over them. The
  quiz itself uses the quiz strings; its scope label is here.
-->
<!-- "Card 1 of 5" never changes its wording with the number: a plain string, like the flashcards' one. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PluralsCandidate">
    <!-- The entry on the Flashcards study chooser (the screen's title shares it) -->
    <string name="learn_title">تعلّم 5 جديدة</string>
    <plurals name="learn_option_detail">
        <item quantity="zero">لا أعلام لم ترها بعد</item>
        <item quantity="one">علم واحد لم تره بعد</item>
        <item quantity="two">علمان لم ترهما بعد</item>
        <item quantity="few">%1$d أعلام لم ترها بعد</item>
        <item quantity="many">%1$d علمًا لم تره بعد</item>
        <item quantity="other">%1$d علم لم تره بعد</item>
    </plurals>

    <!-- The cards -->
    <string name="learn_intro">خمسة أعلام لم ترها بعد، ثم اختبار قصير.</string>
    <string name="learn_card_position">البطاقة %1$d من %2$d</string>
    <string name="learn_not_to_confuse">لا يُخلط مع</string>
    <string name="learn_previous">السابق</string>
    <string name="learn_next">التالي</string>
    <string name="learn_quiz_me">اختبرني</string>

    <!-- Nothing left to introduce -->
    <string name="learn_nothing_new">لقد رأيت كل الأعلام. تواصل الاختبارات مراجعتها.</string>

    <!-- The scope of the quiz after the cards, in the quiz log -->
    <string name="scope_learn">تعلّم</string>
    <string name="learn_borders">الحدود: %1$s</string>
    <string name="learn_no_borders">لا حدود برية</string>
</resources>
