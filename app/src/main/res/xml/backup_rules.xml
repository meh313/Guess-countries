<?xml version="1.0" encoding="utf-8"?>
<!--
   The same rules for Android 11 and older (Auto Backup): the progress database and the settings file, nothing
   else (WorkManager's database is not listed).
-->
<full-backup-content>
    <include domain="database" path="world_flags_db" />
    <include domain="database" path="world_flags_db-wal" />
    <include domain="database" path="world_flags_db-shm" />
    <include domain="sharedpref" path="settings.xml" />
</full-backup-content>
