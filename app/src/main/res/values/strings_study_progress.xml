<?xml version="1.0" encoding="utf-8"?>
<!--
  The Flashcards screen (browsing the deck and study sessions) and the Progress screen (stats, the streak, the quiz
  log and the daily reminder card). Shared words (Done, Clear filters, scopes, continents, standings…) live in
  strings.xml.
-->
<!-- Counts whose wording does not change with the number, or that are never 1, stay plain strings. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PluralsCandidate">
    <!-- Flashcards: the deck header, the filter notice and the empty deck -->
    <string name="flashcards_title">Flashcards</string>
    <string name="flashcards_card_position">Card %1$d of %2$d</string>
    <string name="flashcards_shuffle">Shuffle cards</string>
    <string name="flashcards_reset">Reset deck</string>
    <string name="flashcards_filter_saved_only">Saved only</string>
    <string name="flashcards_filter_search">\"%1$s\"</string>
    <string name="flashcards_filter_sorted_by">Sorted by %1$s</string>
    <string name="flashcards_filter_notice">Deck filtered by Explore: %1$s</string>
    <!-- The Study button; "Study" alone when nothing is due -->
    <plurals name="flashcards_study_due">
        <item quantity="one">Study · %d due</item>
        <item quantity="other">Study · %d due</item>
    </plurals>
    <string name="flashcards_action_clear">Clear</string>
    <string name="flashcards_empty">No flashcards available for current filters.</string>

    <!-- Flashcards: the flip card -->
    <string name="flashcards_reveal">Reveal country name and capital</string>
    <string name="flashcards_show_flag_again">Show the flag again</string>
    <string name="flashcards_state_flag">Showing the flag</string>
    <string name="flashcards_state_details">Showing country details</string>
    <string name="flashcards_tap_to_reveal">Tap to reveal the country name &amp; capital</string>
    <!-- A capital study card: the front names the country and asks; the back answers -->
    <string name="flashcards_capital_prompt">What is the capital?</string>
    <string name="flashcards_tap_to_reveal_capital">Tap to reveal the capital</string>
    <string name="flashcards_reveal_capital">Reveal the capital</string>
    <string name="flashcards_state_capital">Showing the capital</string>
    <string name="flashcards_population">Population</string>
    <string name="flashcards_flag_meaning">Flag meaning</string>
    <string name="flashcards_trivia">Trivia fact</string>

    <!-- Flashcards: Previous and Next -->
    <string name="flashcards_previous">Previous</string>
    <string name="flashcards_next">Next</string>

    <!-- Study: the chooser dialog (the Study icon shares its title) -->
    <string name="study_title">Study</string>
    <string name="study_chooser_intro">Up to %1$d cards; grade each one after the flip. Ten or more count as practice.</string>
    <plurals name="study_due_detail">
        <item quantity="one">%1$d card due for review</item>
        <item quantity="other">%1$d cards due for review</item>
    </plurals>
    <!-- The capitals due for review: a study source, stored as StudySession.CAPITALS_DUE -->
    <string name="study_source_capitals_due">Capitals due</string>
    <plurals name="study_capitals_due_detail">
        <item quantity="one">%1$d capital due for review</item>
        <item quantity="other">%1$d capitals due for review</item>
    </plurals>
    <string name="study_weak_detail">%1$d reviewed, not mastered</string>
    <plurals name="study_deck_detail">
        <item quantity="one">the next %1$d card from here</item>
        <item quantity="other">the next %1$d cards from here</item>
    </plurals>

    <!-- Study: the session -->
    <string name="study_header">Study · %1$s</string>
    <string name="study_position_rehearsal">Card %1$d of %2$d · again</string>
    <string name="study_undo">Undo last grade</string>
    <string name="study_end">End</string>
    <string name="study_grade_prompt">How well did you know it?</string>
    <string name="study_flip_to_grade">Flip the card to grade it</string>
    <string name="study_grade_again">Again</string>
    <string name="study_grade_good">Good</string>
    <string name="study_grade_easy">Easy</string>

    <!-- Study: the summary (the quiz log reuses study_summary_remembered) -->
    <string name="study_summary_title">Session complete</string>
    <string name="study_summary_remembered">%1$d of %2$d remembered</string>
    <string name="study_summary_grades">Again %1$d · Good %2$d · Easy %3$d</string>
    <string name="study_streak_already_counted">%1$d-day streak, already counted today</string>
    <string name="study_streak_short">Grade at least %1$d cards for it to count towards your goal (you graded %2$d)</string>
    <string name="study_again">Study again</string>

    <!-- Progress: the header -->
    <string name="stats_title">Progress</string>
    <string name="stats_subtitle">Track flag mastery &amp; quiz achievements</string>
    <string name="stats_settings">Settings</string>

    <!-- Progress: the streak card -->
    <string name="stats_no_streak">No streak yet</string>
    <plurals name="stats_streak_title">
        <item quantity="one">%d-day streak</item>
        <item quantity="other">%d-day streak</item>
    </plurals>
    <string name="stats_streak_start">Meet today\'s goal to start one</string>
    <string name="stats_streak_detail">%1$s · %2$s</string>
    <plurals name="stats_streak_best">
        <item quantity="one">Best: %d day</item>
        <item quantity="other">Best: %d days</item>
    </plurals>
    <string name="stats_practiced_today">Practised today</string>
    <string name="stats_not_yet_today">Not yet today</string>

    <!-- Progress: the metric tiles -->
    <string name="stats_mastered_flags">Mastered flags</string>
    <string name="stats_capitals_known">Capitals known</string>
    <string name="stats_ratio">%1$d / %2$d</string>
    <string name="stats_due_today">Due today</string>
    <!-- The Due tile's value when capitals are due too: "flags 4 · capitals 2"; with map reviews due as well: "flags 4 · capitals 2 · map 1" -->
    <string name="stats_due_both">flags %1$d · capitals %2$d</string>
    <string name="stats_due_three">flags %1$d · capitals %2$d · map %3$d</string>
    <string name="stats_learning">Learning</string>
    <!-- Countries placed on the map and remembered (the map skill): "On the map 12 / 196" -->
    <string name="stats_located">On the map</string>
    <string name="stats_due_open">Start a study session of the cards due</string>
    <string name="stats_saved">Saved</string>
    <string name="stats_quizzes_finished">Quizzes finished</string>
    <string name="stats_highest_score">Highest score</string>
    <string name="stats_points">%1$d pts</string>
    <string name="stats_blitz_best">Blitz best: %1$d</string>
    <!-- What TalkBack reads for a tile: title, value and (when there is one) the detail line -->
    <string name="stat_badge_description">%1$s: %2$s</string>
    <string name="stat_badge_description_detail">%1$s: %2$s · %3$s</string>

    <!-- Progress: the week ahead, under the tiles ("Coming up: 4 due tomorrow · 12 this week"); hidden when nothing is coming -->
    <string name="stats_forecast">Coming up: %1$s · %2$s</string>
    <string name="stats_forecast_tomorrow">%1$d due tomorrow</string>
    <string name="stats_forecast_week">%1$d this week</string>

    <!-- Progress: the pairs of countries mixed up most often, each row opening how to tell them apart -->
    <string name="stats_confused_heading">Most confused</string>
    <string name="stats_confused_pair">%1$s ↔ %2$s</string>
    <string name="stats_confused_times">× %1$d</string>
    <plurals name="stats_confused_description">
        <item quantity="one">%1$s, mixed up %2$d time</item>
        <item quantity="other">%1$s, mixed up %2$d times</item>
    </plurals>
    <string name="stats_confused_open">Show how to tell them apart</string>

    <!-- Progress: continent mastery -->
    <string name="stats_continent_heading">Mastery by continent</string>
    <string name="stats_continent_open">Show the %1$s countries still to learn</string>
    <string name="stats_mastered_of">%1$d of %2$d mastered</string>
    <string name="stats_capitals_count">Capitals: %1$d of %2$d</string>

    <!-- Progress: the quiz log -->
    <string name="stats_log_heading">Recent quizzes</string>
    <string name="stats_log_empty">No quizzes yet. Finish a quiz or a study session and it shows up here.</string>
    <string name="stats_log_entry">%1$s · %2$s</string>
    <string name="stats_log_result">%1$d/%2$d · %3$d pts</string>
    <string name="stats_log_blitz">%1$d correct · %2$d pts</string>
    <string name="stats_log_show_all">Show all</string>
    <!-- A log row with stored answers is a button that opens its result screen again -->
    <string name="stats_log_open">Open this quiz\'s result</string>

    <!-- The daily reminder card -->
    <string name="reminder_title">Daily reminder</string>
    <string name="reminder_detail">A nudge at %1$s, only on days short of your goal</string>
    <string name="reminder_time">Remind me at %1$s</string>
    <string name="reminder_blocked">Allow notifications for %1$s in system settings to get the reminder.</string>
    <string name="reminder_open_settings">Open settings</string>
    <string name="reminder_ok">OK</string>
</resources>
