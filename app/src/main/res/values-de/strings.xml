    <string name="reminder_channel_name">Tägliche Erinnerung</string>
    <string name="reminder_channel_description">Ein Anstoß zu einem Quiz, wenn du heute noch nicht geübt hast</string>
    <string name="reminder_keep_title">Halte deine Serie</string>
    <plurals name="reminder_keep_text">
        <item quantity="one">Ein Quiz hält deine Serie von %d Tag</item>
        <item quantity="other">Ein Quiz hält deine Serie von %d Tagen</item>
    </plurals>
    <string name="reminder_start_title">Zeit für ein kurzes Quiz</string>
    <string name="reminder_start_text">Ein kurzes Quiz startet eine neue Serie</string>

    <!-- Shown once when a database write failed (see WriteErrors) -->
    <string name="write_error">Deine letzte Änderung konnte nicht gespeichert werden. Exportiere deinen Fortschritt in den Einstellungen und versuche es später noch einmal.</string>

    <!-- The home-screen widget. -->
    <string name="widget_label">Heutige Wiederholungen</string>
    <string name="widget_description">Wie viele Wiederholungen fällig sind, deine Serie und ein Üben-Button</string>
    <plurals name="widget_due">
        <item quantity="one">%1$d Wiederholung fällig</item>
        <item quantity="other">%1$d Wiederholungen fällig</item>
    </plurals>
    <string name="widget_nothing_due">Nichts fällig</string>
    <string name="widget_streak_today">Serie %1$d · heute %2$d/%3$d</string>
    <string name="widget_practise">Üben</string>
</resources>
