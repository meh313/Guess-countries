    <string name="pips_description">%1$s: %2$s, %3$s: %4$s</string>

    <!-- Skills -->
    <string name="skill_flag">Flagge</string>
    <string name="skill_capital">Hauptstadt</string>
    <string name="skill_continent">Kontinent</string>
    <string name="skill_location">Karte</string>

    <!-- Settings enums -->
    <string name="theme_system">System</string>
    <string name="theme_light">Hell</string>
    <string name="theme_dark">Dunkel</string>
    <string name="timer_normal">Normal</string>
    <string name="timer_relaxed">Entspannt</string>
    <string name="timer_off">Kein Limit</string>

