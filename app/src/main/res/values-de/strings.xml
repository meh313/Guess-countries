    <string name="mode_blitz">%1$d-Sekunden-Blitz</string>
    <string name="mode_blitz_hint">So viele Flaggen wie möglich in einer Minute</string>
    <string name="mode_flashcards">Lernkarten</string>

    <!-- What a question asks, per mode -->
    <string name="question_flag_name">Zu welchem Land gehört diese Flagge?</string>
    <string name="question_pick_flag">Welche davon ist die Flagge von %1$s?</string>
    <string name="question_capital">Wie heißt die Hauptstadt von %1$s?</string>
