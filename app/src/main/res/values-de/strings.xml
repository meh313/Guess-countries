    <string name="streak_goal_short">Reicht noch nicht für das heutige Ziel</string>
    <plurals name="streak_kept">
        <item quantity="one">Serie gehalten: %d Tag</item>
        <item quantity="other">Serie gehalten: %d Tage</item>
    </plurals>

    <!-- Quiz modes (display titles; the stored value is the enum name) -->
    <string name="mode_flag_name">Flagge → Land</string>
    <string name="mode_pick_flag">Land → Flagge</string>
    <string name="mode_pick_flag_hint">Wähle die richtige Flagge aus vier</string>
    <string name="mode_capital">Land → Hauptstadt</string>
    <string name="mode_continent">Flagge → Kontinent</string>
    <string name="mode_continent_hint">Umfasst die ganze Welt</string>
