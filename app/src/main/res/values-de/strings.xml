<?xml version="1.0" encoding="utf-8"?>
<!--
  Words shared by more than one screen, and the labels of the enums (quiz modes, scopes, sort orders, standings…),
  which `ui/Labels.kt` maps to. Each screen keeps its own words in `strings_<screen>.xml`. Stored values (quiz mode
  names, scope keys, continent names, study sources) are never these strings: they stay the English keys and are
  translated on display only.
-->
<resources>
    <string name="app_name">World Flags</string>
    <plurals name="countries_count">
        <item quantity="one">%d Land</item>
        <item quantity="other">%d Länder</item>
    </plurals>

    <!-- Tabs -->
    <string name="nav_explore">Entdecken</string>
    <string name="nav_flashcards">Lernkarten</string>
    <string name="nav_quiz">Quiz</string>
    <string name="nav_progress">Fortschritt</string>

    <!-- Shared actions and lines -->
    <string name="action_done">Fertig</string>
    <string name="action_back">Zurück</string>
    <string name="action_cancel">Abbrechen</string>
    <string name="action_close">Schließen</string>
    <string name="action_clear_filters">Filter löschen</string>
    <string name="action_read_aloud">Länderinfo vorlesen</string>
    <string name="read_aloud_unavailable">Vorlesen ist auf diesem Gerät nicht verfügbar</string>
    <string name="read_aloud_loading">Vorlesen wird vorbereitet</string>
