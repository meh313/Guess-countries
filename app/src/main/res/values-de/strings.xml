    <string name="sort_noun_area">Fläche</string>
    <string name="sort_noun_continent">Kontinent</string>

    <!-- Standing of a skill (pips, chips, the detail sheet) -->
    <string name="standing_unseen">noch nicht wiederholt</string>
    <string name="standing_weak">noch in Arbeit</string>
    <string name="standing_mastered">gemeistert</string>
    <string name="standing_chip_unseen">Ungesehen</string>
    <string name="standing_chip_weak">In Arbeit</string>
    <string name="standing_chip_mastered">Gemeistert</string>
    <string name="standing_short_unseen">ungesehen</string>
    <string name="standing_short_weak">in Arbeit</string>
    <string name="standing_short_mastered">gemeistert</string>
