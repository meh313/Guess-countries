    <string name="scope_weak_spots">Schwachstellen</string>
    <string name="scope_due_today">Heute fällig</string>
    <string name="scope_mistakes">Fehler</string>
    <string name="study_source_deck">Dieser Stapel</string>

    <!-- Continents (display labels; the catalog keeps the English names as keys) -->
    <string name="continent_all">Alle</string>
    <string name="continent_africa">Afrika</string>
    <string name="continent_americas">Amerika</string>
    <string name="continent_asia">Asien</string>
