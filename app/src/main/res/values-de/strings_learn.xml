<?xml version="1.0" encoding="utf-8"?>
<!--
  Learn mode ("Learn 5 new"): five flags never seen before, one card at a time, then a short quiz over them. The
  quiz itself uses the quiz strings; its scope label is here.
-->
<!-- "Card 1 of 5" never changes its wording with the number: a plain string, like the flashcards' one. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PluralsCandidate">
    <!-- The entry on the Flashcards study chooser (the screen's title shares it) -->
    <string name="learn_title">5 neue lernen</string>
    <plurals name="learn_option_detail">
        <item quantity="one">%1$d Flagge, die du noch nicht gesehen hast</item>
        <item quantity="other">%1$d Flaggen, die du noch nicht gesehen hast</item>
    </plurals>

    <!-- The cards -->
    <string name="learn_intro">Fünf Flaggen, die du noch nicht gesehen hast, dann ein kurzes Quiz.</string>
    <string name="learn_card_position">Karte %1$d von %2$d</string>
    <string name="learn_not_to_confuse">Nicht zu verwechseln mit</string>
    <string name="learn_previous">Zurück</string>
    <string name="learn_next">Weiter</string>
    <string name="learn_quiz_me">Quiz starten</string>

    <!-- Nothing left to introduce -->
    <string name="learn_nothing_new">Du hast jede Flagge gesehen. Die Quizze wiederholen sie weiter.</string>

    <!-- The scope of the quiz after the cards, in the quiz log -->
    <string name="scope_learn">Lernen</string>
    <string name="learn_borders">Grenzen: %1$s</string>
    <string name="learn_no_borders">Keine Landgrenzen</string>
</resources>
