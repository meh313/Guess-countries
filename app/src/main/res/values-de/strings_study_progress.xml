<?xml version="1.0" encoding="utf-8"?>
<!--
  The Flashcards screen (browsing the deck and study sessions) and the Progress screen (stats, the streak, the quiz
  log and the daily reminder card). Shared words (Done, Clear filters, scopes, continents, standings…) live in
  strings.xml.
-->
<!--
  A count is a plurals wherever a word next to it changes with the number in one of the five languages. The plain
  strings hold a fixed number (StudySession.MIN_FOR_STREAK, the study size) or a count no word agrees with ("Card 3
  of 20", "4 of 54 mastered").
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PluralsCandidate">
    <!-- Flashcards: the deck header, the filter notice and the empty deck -->
    <string name="flashcards_title">Lernkarten</string>
    <string name="flashcards_card_position">Karte %1$d von %2$d</string>
    <string name="flashcards_shuffle">Karten mischen</string>
    <string name="flashcards_reset">Stapel zurücksetzen</string>
    <string name="flashcards_filter_saved_only">Nur gemerkte</string>
    <string name="flashcards_filter_search">\"%1$s\"</string>
    <string name="flashcards_filter_sorted_by">Sortiert nach %1$s</string>
    <string name="flashcards_filter_notice">Stapel gefiltert über Entdecken: %1$s</string>
    <!-- The Study button; "Study" alone when nothing is due -->
    <plurals name="flashcards_study_due">
        <item quantity="one">Lernen · %d fällig</item>
        <item quantity="other">Lernen · %d fällig</item>
    </plurals>
    <string name="flashcards_action_clear">Löschen</string>
    <string name="flashcards_empty">Keine Lernkarten für die aktuellen Filter.</string>

    <!-- Flashcards: the flip card -->
    <string name="flashcards_reveal">Ländername und Hauptstadt aufdecken</string>
    <string name="flashcards_show_flag_again">Flagge wieder zeigen</string>
    <string name="flashcards_state_flag">Zeigt die Flagge</string>
    <string name="flashcards_state_details">Zeigt die Länderdetails</string>
    <string name="flashcards_tap_to_reveal">Tippen, um Ländername &amp; Hauptstadt aufzudecken</string>
    <!-- A capital study card: the front names the country and asks; the back answers -->
    <string name="flashcards_capital_prompt">Wie heißt die Hauptstadt?</string>
    <string name="flashcards_tap_to_reveal_capital">Tippen, um die Hauptstadt aufzudecken</string>
    <string name="flashcards_reveal_capital">Hauptstadt aufdecken</string>
    <string name="flashcards_state_capital">Zeigt die Hauptstadt</string>
    <string name="flashcards_population">Einwohner</string>
    <string name="flashcards_flag_meaning">Bedeutung der Flagge</string>
    <string name="flashcards_trivia">Wissenswertes</string>

    <!-- Flashcards: Previous and Next -->
    <string name="flashcards_previous">Zurück</string>
    <string name="flashcards_next">Weiter</string>

    <!-- Study: the chooser dialog (the Study icon shares its title) -->
    <string name="study_title">Lernen</string>
    <string name="study_chooser_intro">Bis zu %1$d Karten; bewerte jede nach dem Umdrehen. Ab zehn zählt es als Üben.</string>
    <plurals name="study_due_detail">
        <item quantity="one">%1$d Karte zur Wiederholung fällig</item>
        <item quantity="other">%1$d Karten zur Wiederholung fällig</item>
    </plurals>
    <!-- The capitals due for review: a study source, stored as StudySession.CAPITALS_DUE -->
    <string name="study_source_capitals_due">Fällige Hauptstädte</string>
    <plurals name="study_capitals_due_detail">
        <item quantity="one">%1$d Hauptstadt zur Wiederholung fällig</item>
        <item quantity="other">%1$d Hauptstädte zur Wiederholung fällig</item>
    </plurals>
    <plurals name="study_weak_detail">
        <item quantity="one">%1$d wiederholt, nicht gemeistert</item>
        <item quantity="other">%1$d wiederholt, nicht gemeistert</item>
    </plurals>
    <plurals name="study_deck_detail">
        <item quantity="one">die nächste %1$d Karte ab hier</item>
        <item quantity="other">die nächsten %1$d Karten ab hier</item>
    </plurals>

    <!-- Study: the session -->
    <string name="study_header">Lernen · %1$s</string>
    <string name="study_position_rehearsal">Karte %1$d von %2$d · nochmal</string>
    <string name="study_undo">Letzte Bewertung zurücknehmen</string>
    <string name="study_end">Beenden</string>
    <string name="study_grade_prompt">Wie gut wusstest du es?</string>
    <string name="study_flip_to_grade">Drehe die Karte um, um sie zu bewerten</string>
    <string name="study_grade_again">Nochmal</string>
    <string name="study_grade_good">Gut</string>
    <string name="study_grade_easy">Leicht</string>

    <!-- Study: the summary (the quiz log reuses study_summary_remembered) -->
    <string name="study_summary_title">Sitzung abgeschlossen</string>
    <string name="study_summary_remembered">%1$d von %2$d gewusst</string>
    <string name="study_summary_grades">Nochmal %1$d · Gut %2$d · Leicht %3$d</string>
    <plurals name="study_streak_already_counted">
        <item quantity="one">Serie von %d Tag, heute schon gezählt</item>
        <item quantity="other">Serie von %d Tagen, heute schon gezählt</item>
    </plurals>
    <string name="study_streak_short">Bewerte mindestens %1$d Karten, damit es für dein Ziel zählt (du hast %2$d bewertet)</string>
    <string name="study_again">Nochmal lernen</string>

    <!-- Progress: the header -->
    <string name="stats_title">Fortschritt</string>
    <string name="stats_subtitle">Verfolge gemeisterte Flaggen &amp; Quiz-Erfolge</string>
    <string name="stats_settings">Einstellungen</string>

    <!-- Progress: the streak card -->
    <string name="stats_no_streak">Noch keine Serie</string>
    <plurals name="stats_streak_title">
        <item quantity="one">Serie von %d Tag</item>
        <item quantity="other">Serie von %d Tagen</item>
    </plurals>
    <string name="stats_streak_start">Erreiche das heutige Ziel, um eine zu starten</string>
    <string name="stats_streak_detail">%1$s · %2$s</string>
    <plurals name="stats_streak_best">
        <item quantity="one">Rekord: %d Tag</item>
        <item quantity="other">Rekord: %d Tage</item>
    </plurals>
    <string name="stats_practiced_today">Heute geübt</string>
    <string name="stats_not_yet_today">Heute noch nicht</string>

    <!-- Progress: the metric tiles -->
    <string name="stats_mastered_flags">Gemeisterte Flaggen</string>
    <string name="stats_capitals_known">Bekannte Hauptstädte</string>
    <string name="stats_ratio">%1$d / %2$d</string>
    <string name="stats_due_today">Heute fällig</string>
    <!-- The Due tile's value when capitals are due too: "flags 4 · capitals 2"; with map reviews due as well: "flags 4 · capitals 2 · map 1" -->
    <string name="stats_due_both">Flaggen %1$d · Hauptstädte %2$d</string>
    <string name="stats_due_three">Flaggen %1$d · Hauptstädte %2$d · Karte %3$d</string>
    <string name="stats_learning">In Arbeit</string>
    <!-- Countries placed on the map and remembered (the map skill): "On the map 12 / 196" -->
    <string name="stats_located">Auf der Karte</string>
    <string name="stats_due_open">Lernsitzung mit den fälligen Karten starten</string>
    <string name="stats_saved">Gemerkt</string>
    <string name="stats_quizzes_finished">Abgeschlossene Quizze</string>
    <string name="stats_highest_score">Höchste Punktzahl</string>
    <plurals name="stats_points">
        <item quantity="one">%d Pkt.</item>
        <item quantity="other">%d Pkt.</item>
    </plurals>
    <string name="stats_blitz_best">Blitz-Rekord: %1$d</string>
    <!-- What TalkBack reads for a tile: title, value and (when there is one) the detail line -->
    <string name="stat_badge_description">%1$s: %2$s</string>
    <string name="stat_badge_description_detail">%1$s: %2$s · %3$s</string>

    <!-- Progress: the week ahead, under the tiles ("Coming up: 4 due tomorrow · 12 this week"); hidden when nothing is coming -->
    <string name="stats_forecast">Demnächst: %1$s · %2$s</string>
    <plurals name="stats_forecast_tomorrow">
        <item quantity="one">%d morgen fällig</item>
        <item quantity="other">%d morgen fällig</item>
    </plurals>
    <string name="stats_forecast_week">%1$d diese Woche</string>

    <!-- Progress: the pairs of countries mixed up most often, each row opening how to tell them apart -->
    <string name="stats_confused_heading">Am häufigsten verwechselt</string>
    <string name="stats_confused_pair">%1$s ↔ %2$s</string>
    <string name="stats_confused_times">× %1$d</string>
    <plurals name="stats_confused_description">
        <item quantity="one">%1$s, %2$d Mal verwechselt</item>
        <item quantity="other">%1$s, %2$d Mal verwechselt</item>
    </plurals>
    <string name="stats_confused_open">Zeigen, wie man sie unterscheidet</string>

    <!-- Progress: continent mastery -->
    <string name="stats_continent_heading">Gemeistert nach Kontinent</string>
    <string name="stats_continent_open">Die noch zu lernenden Länder in %1$s zeigen</string>
    <string name="stats_mastered_of">%1$d von %2$d gemeistert</string>
    <string name="stats_capitals_count">Hauptstädte: %1$d von %2$d</string>

    <!-- Progress: the quiz log -->
    <string name="stats_log_heading">Letzte Quizze</string>
    <string name="stats_log_empty">Noch keine Quizze. Schließe ein Quiz oder eine Lernsitzung ab und es erscheint hier.</string>
    <string name="stats_log_entry">%1$s · %2$s</string>
    <string name="stats_log_result">%1$d/%2$d · %3$s</string>
    <string name="stats_log_blitz">%1$s · %2$s</string>
    <string name="stats_log_show_all">Alle anzeigen</string>
    <!-- A log row with stored answers is a button that opens its result screen again -->
    <string name="stats_log_open">Ergebnis dieses Quiz öffnen</string>

    <!-- The daily reminder card -->
    <string name="reminder_title">Tägliche Erinnerung</string>
    <string name="reminder_detail">Ein Anstoß um %1$s, nur an Tagen ohne erreichtes Ziel</string>
    <string name="reminder_time">Erinnere mich um %1$s</string>
    <string name="reminder_blocked">Erlaube Benachrichtigungen für %1$s in den Systemeinstellungen, um die Erinnerung zu erhalten.</string>
    <string name="reminder_open_settings">Einstellungen öffnen</string>
    <string name="reminder_ok">OK</string>
</resources>
